{
  "name": "pi-console",
  "version": "0.1.0",
  "private": true,
  "description": "One dashboard for the Pi: system stats, Docker services, Claude Code sessions in the browser, app links, backups.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.15"
  },
  "scripts": {
    "start": "node server.js",
    "set-password": "node scripts/set-password.js",
    "test": "node --test test/*.test.js",
    "test:db": "PI_CONSOLE_TEST_DB=1 node --test test/db.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "pg": "8.23.1",
    "ws": "8.22.0"
  }
}
