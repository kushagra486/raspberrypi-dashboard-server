[Unit]
Description=Raspberry Pi dashboard server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/raspberrypi-dashboard-server
Environment=DASHBOARD_REFRESH=3
ExecStart=/home/pi/raspberrypi-dashboard-server/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:8080 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
